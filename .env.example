# ── LINE Bot 設定（必要）───────────────────
CHANNEL_STOCK_ACCESS_TOKEN=your_line_channel_access_token
CHANNEL_STOCK_SECRET=your_line_channel_secret
CHANNEL_STOCK_USER_ID=your_line_user_id
# 或使用多用戶（逗號分隔）
# CHANNEL_STOCK_USER_IDS=user_id_1,user_id_2,user_id_3

# ── Anthropic ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# 或使用 OAuth Token（優先使用）
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 通知設定（可選）───────────────────────
NOTIFY_EMAIL=your@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# ── Notion 整合（可選）────────────────────
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxx
NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
